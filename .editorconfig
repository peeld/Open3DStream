root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,fbs,cs}]
indent_style = tab
tab_width = 4

[{CMakeLists.txt,*.cmake}]
indent_style = tab
tab_width = 4

[*.{py,yml,yaml,json,uplugin,rst}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
